# Explicit opt-in: append only the needed profiles and rules to config.toml.
# Set job_memory_max_bytes = 1073741824 in the daemon scalar settings.
# Copy corresponding signer rules separately. Loading the RPM grants no profile.
# Root is full host administration; namespace root is not a containment boundary.

[[host_profiles]]
capabilities = []
executable_model = "digest_memfd"
join_namespaces = []
lsm = "selinux_workload_required"
memory_max = 268435456
memory_swap_max = 0
no_new_privs = true
pids_max = 128
private_cgroup = true
private_mount = true
profile_id = "host-data-v1"
schema = "sigrund.host-constraints.v1"
seccomp = "no_filter_required"
securebits = 47
verify_exec_stop = false
workload = "data"

[[host_rules]]
requester_uids = [1001]
target_scope = "host"
target_uids = [0]
target_gids = [0]
supplementary_gids = []
profile_sha256 = "2432d58343d34d2bf9e6bf90f14fbde1e43017d5d1c863e18c640ef9ba18aa41"
cross_owner = true

[[host_profiles]]
capabilities = ["CAP_NET_BIND_SERVICE"]
executable_model = "digest_memfd"
join_namespaces = []
lsm = "selinux_workload_required"
memory_max = 268435456
memory_swap_max = 0
no_new_privs = true
pids_max = 128
private_cgroup = true
private_mount = true
profile_id = "host-network-v1"
schema = "sigrund.host-constraints.v1"
seccomp = "no_filter_required"
securebits = 47
verify_exec_stop = false
workload = "network"

