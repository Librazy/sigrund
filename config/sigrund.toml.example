version = "3.0"
# Ordered executable trust models. Omit a model to disable it.
# Only digest_memfd uses max_executable_bytes and executable snapshot RAM.
executable_trust_models = ["fs_verity", "ctime", "digest_direct", "digest_memfd"]

allow_same_uid_elevation = false
require_remote_audit_ack = false
csr_allowed_executable_dirs = ["/usr/bin", "/usr/sbin"]

sigrun_hook_uid = 65534
sigrun_hook_gid = 65534
max_active_hooks_per_uid = 1
max_active_hooks_global = 8
hook_invocations_per_uid = 5
hook_window_secs = 60
hook_timeout_ms = 25000

max_active_sockets_global = 64
max_active_sockets_per_uid = 4
max_io_workers_global = 16
max_io_workers_per_uid = 2
snapshot_ram_global_bytes = 536870912
snapshot_ram_per_uid_bytes = 134217728
max_executable_bytes = 67108864
# Direct hashing uses a fixed 64 KiB buffer, without snapshot RAM.
max_direct_digest_bytes = 268435456
direct_digest_timeout_ms = 5000
max_stdin_bytes = 16777216
request_deadline_ms = 5000
# Fixed admission-based deadline for every TIMEOUT authorization outcome.
authorization_timeout_ms = 120000
request_admissions_global = 256
request_admissions_per_uid = 16
admission_window_secs = 60
max_pending_audits_global = 128
max_pending_audits_per_uid = 8
shutdown_grace_ms = 10000

job_memory_max_bytes = 268435456
job_memory_swap_max_bytes = 0
job_pids_max = 128

collector_base_url = "https://collector.example.invalid"
collector_server_name = "collector.example.invalid"
collector_ca_file = "/etc/sigrund/collector-ca.pem"
collector_client_cert_file = "/etc/sigrund/collector-client.crt"
collector_client_key_file = "/etc/sigrund/collector-client.key"
collector_key_id = "collector-v3"
collector_public_key = "<strict-padded-base64-32-byte-ed25519-key>"
collector_rpc_timeout_ms = 3000

audit_record_max_bytes = 65536
audit_log_high_water_bytes = 1073741824
audit_min_free_bytes = 67108864
max_onetime_window_secs = 3600
max_ttl_secs = 31536000

# Opt into the thin MVP contract. Omit the table for the full-spec profile.
# Collector settings above remain required; replace the public-key placeholder.
# [mvp]
# tty_mode = "stdio"
# hooks_enabled = false
# pty_enabled = false
# max_active_approval_requests = 1
# approval_signer_id = "mandator-alice-yubikey"

# Defaults to true. Only recognized, administrator-maintained OSTree ComposeFS
# roots qualify. Active backing objects must remain protected and unchanged.
# Set false to retain sealed snapshots for ComposeFS executables.
# [digest_direct]
# allow_admin_trusted_composefs = false

[[host_profiles]]
capabilities = []
executable_model = "digest_memfd"
join_namespaces = []
lsm = "no_transition_required"
memory_max = 268435456
memory_swap_max = 0
no_new_privs = true
pids_max = 128
private_cgroup = true
private_mount = true
profile_id = "host-baseline"
schema = "sigrund.host-constraints.v1"
seccomp = "no_filter_required"
securebits = 47
verify_exec_stop = false

[[host_rules]]
requester_uids = [1001]
target_scope = "host"
target_uids = [0, 33]
target_gids = [0, 33]
supplementary_gids = [33, 104]
profile_sha256 = "6135f3b7915f316b816bc26eed46aaa0d2028966850bc769cb69ab169981ffb5"
cross_owner = true

# Optional namespace execution: see namespace-selinux-profiles.toml.example and
# IMPLEMENTATION_NOTES.md#namespace-execution. Configure independent signer rules.
