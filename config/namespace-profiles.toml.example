# Append to a configured v3 daemon file. Phase 2 performs private review only;
# these prospective constraints are never treated as enforced workload state.
# The rootless topology and preparation limits are documented in
# docs/NAMESPACE_PHASE2.md. All configured executable roots must exist in B.
# Host profiles/rules remain required independently.

[[namespace_profiles]]
apparmor = "unsupported"
capabilities = []
executable_model = "digest_memfd"
join_namespaces = ["cgroup", "ipc", "mnt", "net", "pid", "time", "user", "uts"]
memory_max = 268435456
memory_swap_max = 0
no_new_privs = true
pids_max = 32
private_cgroup = true
private_mount = true
profile_id = "selinux-minimal"
schema = "sigrund.constraints.phase0.v1"
seccomp = {audit_arch = 3221225534, errno = 13, kind = "deny_syscalls", syscalls = [110]}
securebits = 15
selinux = {context = "unconfined_u:unconfined_r:sigrund_phase0_t:s0:c1,c2", enforcing = true, policy_change = "reject"}
verify_exec_stop = true

[[namespace_rules]]
requester_uids = [1001]
target_scope = "registered:container-b"
target_uids = [12001]
target_gids = [12001]
supplementary_gids = []
profile_sha256 = "d75771ede07b1e130ae877b42e86fa8bfb2d6b2cc505f3386eddecc32d519eab"
cross_owner = true
