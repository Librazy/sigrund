# Opt-in administration in environments sharing the host user namespace.
# Container containment is best effort; host workload LSM policy still applies.
# See IMPLEMENTATION_NOTES.md#namespace-execution before granting either scope.

[[namespace_profiles]]
apparmor = "unsupported"
capabilities = []
executable_model = "digest_memfd"
join_namespaces = ["cgroup", "ipc", "mnt", "net", "pid", "time", "user", "uts"]
memory_max = 268435456
memory_swap_max = 0
no_new_privs = true
pids_max = 32
private_cgroup = true
private_mount = true
profile_id = "namespace-admin-v1"
schema = "sigrund.constraints.namespace-admin.v1"
seccomp = {kind = "none"}
securebits = 47
selinux = {context = "", enforcing = false, policy_change = "unmanaged"}
verify_exec_stop = true

[[namespace_rules]]
requester_uids = [1001]
target_scope = "registered:container-b"
target_uids = [0]
target_gids = [0]
supplementary_gids = []
profile_sha256 = "1c0cdd8c0bf5645b5bbceefda175afe1e7370b07988dfb023069f605d8f32ab4"
cross_owner = true

[[namespace_rules]]
requester_uids = [1001]
target_scope = "self"
target_uids = [0]
target_gids = [0]
supplementary_gids = []
profile_sha256 = "1c0cdd8c0bf5645b5bbceefda175afe1e7370b07988dfb023069f605d8f32ab4"
cross_owner = false
