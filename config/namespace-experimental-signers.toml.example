# Append inside the selected signer configuration after its existing fields.
# A daemon rule and one signer rule must each independently permit the job.

[[signers.namespace_rules]]
requester_uids = [1001]
target_scope = "registered:container-b"
target_uids = [12001]
target_gids = [12001]
supplementary_gids = []
profile_sha256 = "866b2ad85e718cb1ba73527b5c088d229006ef6a24071f4e573b76ff52b1ea56"
cross_owner = true

[[signers.namespace_rules]]
requester_uids = [1001]
target_scope = "self"
target_uids = [12001]
target_gids = [12001]
supplementary_gids = []
profile_sha256 = "866b2ad85e718cb1ba73527b5c088d229006ef6a24071f4e573b76ff52b1ea56"
cross_owner = false
