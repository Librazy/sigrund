[Unit]
Description=sigrund signed command elevation daemon
After=local-fs.target
ConditionPathExists=/var/lib/sigrund-mvp-fixture-e8dcbad9426b/config.toml
ConditionPathExists=/var/lib/sigrund-mvp-fixture-e8dcbad9426b/signers.toml

[Service]
Type=notify
NotifyAccess=main
User=root
Group=root
ExecStart=/var/lib/sigrund-mvp-fixture-e8dcbad9426b/bin/sigrund --foreground --config /var/lib/sigrund-mvp-fixture-e8dcbad9426b/config.toml --signers /var/lib/sigrund-mvp-fixture-e8dcbad9426b/signers.toml --state-dir /var/lib/sigrund-mvp-fixture-e8dcbad9426b/state --log-path /var/lib/sigrund-mvp-fixture-e8dcbad9426b/log/audit.jsonl --socket /run/sigrund-mvp-1f3b2388dc09/client.sock --approval-socket /run/sigrund-mvp-1f3b2388dc09/approve.sock
Restart=on-failure
RestartSec=2s
Delegate=yes
KillMode=control-group
SendSIGKILL=yes
TimeoutStartSec=30s
# Must exceed config.shutdown_grace_ms (default 10000).
TimeoutStopSec=15s
# Fatal shutdown stops heartbeats; systemd cleans up even if ownership stalls.
WatchdogSec=3s
RuntimeDirectory=sigrund-mvp-1f3b2388dc09
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=no
UMask=0077

[Install]
WantedBy=multi-user.target
