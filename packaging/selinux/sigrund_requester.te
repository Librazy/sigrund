policy_module(sigrund_requester, 1.0.0)

# The qualified deployment starts the untrusted account through a host-owned
# systemd unit in this domain. Do not add domain or unconfined attributes:
# Fedora's generic user-domain transitions would allow producer impersonation.
type sigrund_requester_t;
gen_require(`
    type init_t;
    type unconfined_t;
    type sigrund_daemon_t;
    type sigrund_workload_t;
    type sigrund_host_workload_t;
    type sigrund_runtime_t;
    type sigrund_execution_socket_t;
    type sigrund_context_socket_t;
    type sigrund_anchor_socket_t;
    type security_t;
    type nsfs_t;
    type tmp_t;
    attribute domain;
    attribute file_type;
    role system_r;
')
role system_r types sigrund_requester_t;
allow init_t sigrund_requester_t:process transition;
allow init_t sigrund_requester_t:process { signal sigkill sigstop signull getattr getsched };
allow sigrund_requester_t init_t:process sigchld;
allow sigrund_requester_t file_type:file { entrypoint execute execute_no_trans read open getattr map };
allow sigrund_requester_t self:process { fork sigchld signal sigkill sigstop signull ptrace getsched setsched getcap setcap setpgid getpgid getsession getattr };
allow sigrund_requester_t self:capability { chown dac_override dac_read_search fowner fsetid kill setuid setgid setpcap sys_admin sys_chroot sys_ptrace };
allow sigrund_requester_t self:cap_userns { chown dac_override dac_read_search fowner fsetid kill setuid setgid setpcap sys_admin sys_chroot sys_ptrace };
allow sigrund_requester_t self:user_namespace create;
allow sigrund_requester_t self:unix_stream_socket create_stream_socket_perms;
allow sigrund_requester_t self:unix_stream_socket connectto;
allow sigrund_requester_t self:unix_dgram_socket create_socket_perms;
allow sigrund_requester_t self:fd use;
allow sigrund_requester_t self:fifo_file rw_fifo_file_perms;
allow sigrund_requester_t self:dir { read open search getattr };
allow sigrund_requester_t self:file { read open write getattr map };
allow sigrund_requester_t self:lnk_file { read getattr };
allow sigrund_requester_t self:anon_inode { create read write getattr ioctl };
allow sigrund_requester_t security_t:file map;
allow sigrund_requester_t nsfs_t:file { open read getattr ioctl };
allow sigrund_requester_t { init_t domain }:fd use;
allow sigrund_requester_t { init_t domain }:fifo_file rw_fifo_file_perms;
allow sigrund_requester_t { init_t domain }:unix_stream_socket { read write getattr getopt setopt shutdown ioctl };
allow sigrund_requester_t sigrund_runtime_t:sock_file { write getattr };
allow sigrund_requester_t { sigrund_execution_socket_t sigrund_context_socket_t sigrund_anchor_socket_t }:unix_stream_socket { connectto read write getattr getopt setopt shutdown ioctl };
allow sigrund_daemon_t sigrund_requester_t:process { ptrace signal sigkill sigstop signull getattr getsched };
allow sigrund_daemon_t sigrund_requester_t:fd use;
allow sigrund_daemon_t sigrund_requester_t:dir { read open search getattr };
allow sigrund_daemon_t sigrund_requester_t:file { read open getattr };
allow sigrund_daemon_t sigrund_requester_t:lnk_file { read getattr };
allow sigrund_daemon_t sigrund_requester_t:fifo_file rw_fifo_file_perms;
allow sigrund_daemon_t sigrund_requester_t:unix_stream_socket { read write getattr getopt setopt shutdown ioctl };
allow unconfined_t sigrund_requester_t:process { getattr ptrace signal sigkill sigstop signull };
allow unconfined_t sigrund_requester_t:dir { read open search getattr };
allow unconfined_t sigrund_requester_t:file { read open getattr };
allow unconfined_t sigrund_requester_t:lnk_file { read getattr };
allow sigrund_workload_t sigrund_requester_t:fd use;
allow sigrund_workload_t sigrund_requester_t:fifo_file rw_fifo_file_perms;
allow sigrund_workload_t sigrund_requester_t:file { read write append getattr ioctl };
allow sigrund_host_workload_t sigrund_requester_t:fd use;
allow sigrund_host_workload_t sigrund_requester_t:fifo_file rw_fifo_file_perms;
allow sigrund_host_workload_t sigrund_requester_t:file { read write append getattr ioctl };

# These assertions cover the actual attacker domain, independently of Fedora's
# generic domain attribute and of the labels placed on attacker-owned files.
neverallow sigrund_requester_t *:process { transition dyntransition };
neverallow sigrund_requester_t { sigrund_daemon_t sigrund_workload_t sigrund_host_workload_t }:process ptrace;
neverallow sigrund_host_workload_t { sigrund_execution_socket_t sigrund_context_socket_t sigrund_anchor_socket_t }:unix_stream_socket { create relabelfrom relabelto };
neverallow sigrund_requester_t { sigrund_execution_socket_t sigrund_context_socket_t sigrund_anchor_socket_t }:unix_stream_socket { create relabelfrom relabelto };

files_search_all(sigrund_requester_t)
files_list_all(sigrund_requester_t)
files_read_all_files(sigrund_requester_t)
files_read_all_symlinks(sigrund_requester_t)
files_manage_non_security_files(sigrund_requester_t)
files_manage_generic_tmp_dirs(sigrund_requester_t)
allow sigrund_requester_t tmp_t:sock_file manage_sock_file_perms;
files_mounton_non_security(sigrund_requester_t)
files_mount_all_file_type_fs(sigrund_requester_t)
files_unmount_all_file_type_fs(sigrund_requester_t)
files_remount_all_file_type_fs(sigrund_requester_t)
fs_mount_tmpfs(sigrund_requester_t)
fs_unmount_tmpfs(sigrund_requester_t)
fs_manage_tmpfs_dirs(sigrund_requester_t)
fs_manage_tmpfs_files(sigrund_requester_t)
fs_manage_tmpfs_sockets(sigrund_requester_t)
fs_getattr_all_fs(sigrund_requester_t)
kernel_read_all_proc(sigrund_requester_t)
kernel_read_all_sysctls(sigrund_requester_t)
selinux_read_security_files(sigrund_requester_t)
selinux_compute_access_vector(sigrund_requester_t)
libs_use_ld_so(sigrund_requester_t)
libs_use_shared_libs(sigrund_requester_t)
dev_read_urand(sigrund_requester_t)
dev_rw_null(sigrund_requester_t)
init_use_fds(sigrund_requester_t)
init_use_notify(sigrund_requester_t)
